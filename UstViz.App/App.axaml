<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.Styling"
             xmlns:local="using:UstViz.App"
             x:Class="UstViz.App.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!-- 图标字体：Segoe MDL2 Assets 为实心风格，比 Fluent Icons 细线条更醒目 -->
        <FontFamily x:Key="SymbolThemeFontFamily">Segoe MDL2 Assets</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <!-- PreferUserAccentColor: 主题色跟随系统强调色 -->
        <fa:FluentAvaloniaTheme PreferUserAccentColor="True" />
    </Application.Styles>
</Application>

