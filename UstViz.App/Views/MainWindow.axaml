<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UstViz.App.ViewModels"
        xmlns:conv="using:UstViz.App.Converters"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1100" d:DesignHeight="750"
        x:Class="UstViz.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1100" Height="750"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Title="UST Visualizer - UST 可视化">

    <Window.Resources>
        <conv:StringToBrushConverter x:Key="BrushConverter" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="#808080" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.quick">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Grid.setrow">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel Margin="0">

        <!-- ============ 顶部标题栏 ============ -->
        <Border DockPanel.Dock="Top" Padding="20,12,16,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <fa:FASymbolIcon Symbol="{x:Static fa:FASymbol.Audio}" FontSize="24" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="UST Visualizer" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="UTAU 工程可视化 · 生成滚动音符视频" FontSize="12" Opacity="0.65" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Classes="accent" Padding="14,6"
                        Content="切换主题"
                        Command="{Binding ToggleThemeCommand}" />
            </Grid>
        </Border>

        <!-- ============ 侧边栏导航 + 内容区 ============ -->
        <fa:FANavigationView x:Name="NavView" DockPanel.Dock="Bottom"
                             PaneDisplayMode="Left" OpenPaneLength="200"
                             IsPaneOpen="True"
                             SelectionChanged="OnNavSelectionChanged">

            <fa:FANavigationView.MenuItems>
                <fa:FANavigationViewItem Content="文件" Tag="file">
                    <fa:FANavigationViewItem.IconSource>
                        <fa:FASymbolIconSource Symbol="{x:Static fa:FASymbol.Folder}" FontSize="20" />
                    </fa:FANavigationViewItem.IconSource>
                </fa:FANavigationViewItem>
                <fa:FANavigationViewItem Content="生成" Tag="generate">
                    <fa:FANavigationViewItem.IconSource>
                        <fa:FASymbolIconSource Symbol="{x:Static fa:FASymbol.Video}" FontSize="20" />
                    </fa:FANavigationViewItem.IconSource>
                </fa:FANavigationViewItem>
                <fa:FANavigationViewItem Content="基本设置" Tag="basic">
                    <fa:FANavigationViewItem.IconSource>
                        <fa:FASymbolIconSource Symbol="{x:Static fa:FASymbol.Setting}" FontSize="20" />
                    </fa:FANavigationViewItem.IconSource>
                </fa:FANavigationViewItem>
                <fa:FANavigationViewItem Content="动画设置" Tag="animation">
                    <fa:FANavigationViewItem.IconSource>
                        <fa:FASymbolIconSource Symbol="{x:Static fa:FASymbol.Play}" FontSize="20" />
                    </fa:FANavigationViewItem.IconSource>
                </fa:FANavigationViewItem>
                <fa:FANavigationViewItem Content="样式设置" Tag="style">
                    <fa:FANavigationViewItem.IconSource>
                        <fa:FASymbolIconSource Symbol="{x:Static fa:FASymbol.Font}" FontSize="20" />
                    </fa:FANavigationViewItem.IconSource>
                </fa:FANavigationViewItem>
                <fa:FANavigationViewItem Content="颜色设置" Tag="color">
                    <fa:FANavigationViewItem.IconSource>
                        <fa:FASymbolIconSource Symbol="{x:Static fa:FASymbol.Highlight}" FontSize="20" />
                    </fa:FANavigationViewItem.IconSource>
                </fa:FANavigationViewItem>
            </fa:FANavigationView.MenuItems>
            <fa:FANavigationView.FooterMenuItems>
                <fa:FANavigationViewItem Content="设置" Tag="settings">
                    <fa:FANavigationViewItem.IconSource>
                        <fa:FASymbolIconSource Symbol="{x:Static fa:FASymbol.Setting}" FontSize="20" />
                    </fa:FANavigationViewItem.IconSource>
                </fa:FANavigationViewItem>
            </fa:FANavigationView.FooterMenuItems>

            <fa:FANavigationView.Content>
                <Grid Margin="16,8,16,16" RowDefinitions="Auto,*">

                    <!-- ===== 顶部状态区：InfoBar + 进度 ===== -->
                    <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,10">
                        <fa:FAInfoBar x:Name="StatusBar" IsOpen="True" Severity="Informational"
                                      Title="状态" Message="{Binding ProgressText}" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}"
                                     Height="14" ShowProgressText="True" />
                    </StackPanel>

                    <!-- ===== 页面容器 ===== -->

                    <!-- 文件页 -->
                    <ScrollViewer Grid.Row="1" x:Name="PageFile" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="720" HorizontalAlignment="Stretch" Margin="0,0,12,0">
                            <fa:FASettingsExpander Header="文件设置" Description="选择 UST、输出目录与字体">
                                <fa:FASettingsExpander.IconSource>
                                    <fa:FASymbolIconSource Symbol="{x:Static fa:FASymbol.Folder}" FontSize="20" />
                                </fa:FASettingsExpander.IconSource>
                                <StackPanel Spacing="6" Margin="0,6,0,0">
                                    <Button Content="选择 UST 文件" Classes="quick" Command="{Binding SelectUstFileCommand}" />
                                    <TextBlock Classes="hint" Text="{Binding UstFile}" ToolTip.Tip="{Binding UstFile}" />
                                    <Button Content="选择输出文件夹" Classes="quick" Command="{Binding SelectOutputFolderCommand}" />
                                    <TextBlock Classes="hint" Text="{Binding OutputFolder}" ToolTip.Tip="{Binding OutputFolder}" />
                                    <Button Content="选择字体文件" Classes="quick" Command="{Binding SelectFontFileCommand}" />
                                    <TextBlock Classes="hint" Text="{Binding FontFile}" ToolTip.Tip="{Binding FontFile}" />
                                </StackPanel>
                            </fa:FASettingsExpander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 生成页 -->
                    <ScrollViewer Grid.Row="1" x:Name="PageGenerate" IsVisible="False" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="720" Spacing="12" Margin="0,0,12,0">
                            <fa:FASettingsExpander Header="快速操作" Description="预览与导出视频">
                                <fa:FASettingsExpander.IconSource>
                                    <fa:FASymbolIconSource Symbol="{x:Static fa:FASymbol.Play}" FontSize="20" />
                                </fa:FASettingsExpander.IconSource>
                                <StackPanel Spacing="6" Margin="0,6,0,0">
                                    <Button Content="实时预览" Classes="quick accent" Command="{Binding StartPreviewCommand}" />
                                    <Button Content="生成视频" Classes="quick accent" Command="{Binding GenerateCommand}" />
                                    <Button Content="停止生成" Classes="quick" Command="{Binding StopGenerateCommand}" />
                                    <Button Content="打开输出文件夹" Classes="quick" Command="{Binding OpenOutputFolderCommand}" />
                                </StackPanel>
                            </fa:FASettingsExpander>
                            <fa:FASettingsExpander Header="输出设置" Description="视频格式与 ffmpeg">
                                <fa:FASettingsExpander.IconSource>
                                    <fa:FASymbolIconSource Symbol="{x:Static fa:FASymbol.Video}" FontSize="20" />
                                </fa:FASettingsExpander.IconSource>
                                <StackPanel Spacing="8" Margin="0,6,0,0">
                                    <Grid ColumnDefinitions="56,*">
                                        <TextBlock Text="格式:" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding OutputFormats}"
                                                  SelectedItem="{Binding OutputFormat, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock Classes="hint" Text="ffmpeg 路径（MP4 需要，可留空自动检测）" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Text="{Binding FfmpegPath, Mode=TwoWay}"
                                                 PlaceholderText="自动检测 / 手动指定 ffmpeg.exe" />
                                        <Button Grid.Column="1" Content="浏览" Margin="6,0,0,0"
                                                Command="{Binding SelectFfmpegFileCommand}" />
                                    </Grid>
                                </StackPanel>
                            </fa:FASettingsExpander>
                            <fa:FASettingsExpander Header="配置管理" Description="保存/加载 JSON 配置">
                                <fa:FASettingsExpander.IconSource>
                                    <fa:FASymbolIconSource Symbol="{x:Static fa:FASymbol.Save}" FontSize="20" />
                                </fa:FASettingsExpander.IconSource>
                                <StackPanel Spacing="6" Margin="0,6,0,0">
                                    <Button Content="保存配置" Classes="quick" Command="{Binding SaveConfigCommand}" />
                                    <Button Content="加载配置" Classes="quick" Command="{Binding LoadConfigCommand}" />
                                </StackPanel>
                            </fa:FASettingsExpander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 基本设置页 -->
                    <ScrollViewer Grid.Row="1" x:Name="PageBasic" IsVisible="False" VerticalScrollBarVisibility="Auto">
                        <fa:FASettingsExpander Header="基本设置" Description="分辨率 · 帧率 · 字体 · 背景" MaxWidth="720" HorizontalAlignment="Stretch" Margin="0,0,12,0">
                            <fa:FASettingsExpander.IconSource>
                                <fa:FASymbolIconSource Symbol="{x:Static fa:FASymbol.Setting}" FontSize="20" />
                            </fa:FASettingsExpander.IconSource>
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="分辨率" Classes="section" />
                                <Grid ColumnDefinitions="56,*,56">
                                    <TextBlock Text="宽度:" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="320" Maximum="7680"
                                            Value="{Binding Width, Mode=TwoWay}" Margin="10,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Width}" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="56,*,56" Classes="setrow">
                                    <TextBlock Text="高度:" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="240" Maximum="4320"
                                            Value="{Binding Height, Mode=TwoWay}" Margin="10,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Height}" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="其他" Classes="section" />
                                <Grid ColumnDefinitions="56,*,56">
                                    <TextBlock Text="帧率:" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="1" Maximum="60"
                                            Value="{Binding Fps, Mode=TwoWay}" Margin="10,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Fps}" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="56,*,56" Classes="setrow">
                                    <TextBlock Text="字体大小:" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="8" Maximum="96"
                                            Value="{Binding FontSize, Mode=TwoWay}" Margin="10,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding FontSize}" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <CheckBox Content="透明背景（用于叠加素材）" IsChecked="{Binding TransparentBackground, Mode=TwoWay}" Margin="0,10,0,4" />
                            </StackPanel>
                        </fa:FASettingsExpander>
                    </ScrollViewer>

                    <!-- 动画设置页 -->
                    <ScrollViewer Grid.Row="1" x:Name="PageAnimation" IsVisible="False" VerticalScrollBarVisibility="Auto">
                        <fa:FASettingsExpander Header="动画设置" Description="滚动速度 · 判定线 · 淡入淡出 · 纵向偏移" MaxWidth="720" HorizontalAlignment="Stretch" Margin="0,0,12,0">
                            <fa:FASettingsExpander.IconSource>
                                <fa:FASymbolIconSource Symbol="{x:Static fa:FASymbol.Play}" FontSize="20" />
                            </fa:FASettingsExpander.IconSource>
                            <StackPanel Margin="0,4,0,0">
                                <Grid ColumnDefinitions="96,*,64">
                                    <TextBlock Text="滚动速度:" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="100" Maximum="2000"
                                            Value="{Binding ScrollSpeed, Mode=TwoWay}" Margin="10,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding ScrollSpeed}" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="96,*,64" Classes="setrow">
                                    <TextBlock Text="判定线位置:" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0.1" Maximum="0.5"
                                            Value="{Binding JudgmentLinePosition, Mode=TwoWay}" Margin="10,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding JudgmentLinePosition}" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="96,*,64" Classes="setrow">
                                    <TextBlock Text="淡入淡出:" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="5"
                                            Value="{Binding FadeDuration, Mode=TwoWay}" Margin="10,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding FadeDuration}" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="96,*,64" Classes="setrow">
                                    <TextBlock Text="纵向偏移:" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="-200" Maximum="200"
                                            Value="{Binding VerticalOffset, Mode=TwoWay}" Margin="10,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding VerticalOffset}" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </fa:FASettingsExpander>
                    </ScrollViewer>

                    <!-- 样式设置页 -->
                    <ScrollViewer Grid.Row="1" x:Name="PageStyle" IsVisible="False" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="720" Spacing="12" Margin="0,0,12,0">
                            <fa:FASettingsExpander Header="音符与歌词" Description="厚度 · 圆角 · 阴影 · 歌词显示">
                                <fa:FASettingsExpander.IconSource>
                                    <fa:FASymbolIconSource Symbol="{x:Static fa:FASymbol.Font}" FontSize="20" />
                                </fa:FASettingsExpander.IconSource>
                                <StackPanel Margin="0,4,0,0">
                                    <Grid ColumnDefinitions="96,*,56">
                                        <TextBlock Text="音符厚度:" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="4" Maximum="80"
                                                Value="{Binding NoteHeight, Mode=TwoWay}" Margin="10,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding NoteHeight}" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="96,*,56" Classes="setrow">
                                        <TextBlock Text="圆角半径:" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="40"
                                                Value="{Binding NoteCornerRadius, Mode=TwoWay}" Margin="10,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding NoteCornerRadius}" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <CheckBox Content="音符阴影" IsChecked="{Binding NoteShadow, Mode=TwoWay}" Margin="0,8,0,0" />
                                    <CheckBox Content="显示歌词" IsChecked="{Binding ShowLyric, Mode=TwoWay}" Margin="0,6,0,0" />
                                    <Grid ColumnDefinitions="96,*,56" Classes="setrow">
                                        <TextBlock Text="歌词偏移:" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="5" Maximum="80"
                                                Value="{Binding LyricOffset, Mode=TwoWay}" Margin="10,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding LyricOffset}" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </fa:FASettingsExpander>
                            <fa:FASettingsExpander Header="音高曲线" Description="显示 · 宽度 · 阴影 · 端点 · 平滑度">
                                <fa:FASettingsExpander.IconSource>
                                    <fa:FASymbolIconSource Symbol="{x:Static fa:FASymbol.Ruler}" FontSize="20" />
                                </fa:FASettingsExpander.IconSource>
                                <StackPanel Margin="0,4,0,0">
                                    <CheckBox Content="显示音高曲线" IsChecked="{Binding ShowPitchCurve, Mode=TwoWay}" />
                                    <Grid ColumnDefinitions="96,*,56" Classes="setrow">
                                        <TextBlock Text="曲线宽度:" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="1" Maximum="10"
                                                Value="{Binding PitchCurveWidth, Mode=TwoWay}" Margin="10,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding PitchCurveWidth}" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="16" Classes="setrow">
                                        <CheckBox Content="曲线阴影" IsChecked="{Binding PitchCurveShadow, Mode=TwoWay}" />
                                        <CheckBox Content="显示端点" IsChecked="{Binding PitchCurveDots, Mode=TwoWay}" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="96,*,56" Classes="setrow">
                                        <TextBlock Text="端点大小:" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="1" Maximum="20"
                                                Value="{Binding PitchCurveDotSize, Mode=TwoWay}" Margin="10,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding PitchCurveDotSize}" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="96,*,56" Classes="setrow">
                                        <TextBlock Text="平滑度:" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="10" Maximum="300"
                                                Value="{Binding PitchCurveSmoothness, Mode=TwoWay}" Margin="10,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding PitchCurveSmoothness}" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </fa:FASettingsExpander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 颜色设置页 -->
                    <ScrollViewer Grid.Row="1" x:Name="PageColor" IsVisible="False" VerticalScrollBarVisibility="Auto">
                        <fa:FASettingsExpander Header="颜色" Description="音符 · 歌词 · 背景 · 判定线 · 曲线" MaxWidth="720" HorizontalAlignment="Stretch" Margin="0,0,12,0">
                            <fa:FASettingsExpander.IconSource>
                                <fa:FASymbolIconSource Symbol="{x:Static fa:FASymbol.Highlight}" FontSize="20" />
                            </fa:FASettingsExpander.IconSource>
                            <StackPanel Margin="0,4,0,0">
                                <Grid ColumnDefinitions="140,80,*,Auto">
                                    <TextBlock Text="音符颜色:" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Width="80" Height="24" CornerRadius="4"
                                            Background="{Binding NoteColorHex, Converter={StaticResource BrushConverter}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding NoteColorHex}" VerticalAlignment="Center" Margin="10,0" />
                                    <Button Grid.Column="3" Content="选择" Padding="12,4"
                                            Command="{Binding ChooseColorCommand}" CommandParameter="NoteColorHex" />
                                </Grid>
                                <Grid ColumnDefinitions="140,80,*,Auto" Classes="setrow">
                                    <TextBlock Text="激活音符颜色:" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Width="80" Height="24" CornerRadius="4"
                                            Background="{Binding ActiveNoteColorHex, Converter={StaticResource BrushConverter}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding ActiveNoteColorHex}" VerticalAlignment="Center" Margin="10,0" />
                                    <Button Grid.Column="3" Content="选择" Padding="12,4"
                                            Command="{Binding ChooseColorCommand}" CommandParameter="ActiveNoteColorHex" />
                                </Grid>
                                <Grid ColumnDefinitions="140,80,*,Auto" Classes="setrow">
                                    <TextBlock Text="歌词颜色:" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Width="80" Height="24" CornerRadius="4"
                                            Background="{Binding LyricColorHex, Converter={StaticResource BrushConverter}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding LyricColorHex}" VerticalAlignment="Center" Margin="10,0" />
                                    <Button Grid.Column="3" Content="选择" Padding="12,4"
                                            Command="{Binding ChooseColorCommand}" CommandParameter="LyricColorHex" />
                                </Grid>
                                <Grid ColumnDefinitions="140,80,*,Auto" Classes="setrow">
                                    <TextBlock Text="背景颜色:" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Width="80" Height="24" CornerRadius="4"
                                            Background="{Binding BackgroundColorHex, Converter={StaticResource BrushConverter}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding BackgroundColorHex}" VerticalAlignment="Center" Margin="10,0" />
                                    <Button Grid.Column="3" Content="选择" Padding="12,4"
                                            Command="{Binding ChooseColorCommand}" CommandParameter="BackgroundColorHex" />
                                </Grid>
                                <Grid ColumnDefinitions="140,80,*,Auto" Classes="setrow">
                                    <TextBlock Text="判定线颜色:" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Width="80" Height="24" CornerRadius="4"
                                            Background="{Binding JudgmentLineColorHex, Converter={StaticResource BrushConverter}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding JudgmentLineColorHex}" VerticalAlignment="Center" Margin="10,0" />
                                    <Button Grid.Column="3" Content="选择" Padding="12,4"
                                            Command="{Binding ChooseColorCommand}" CommandParameter="JudgmentLineColorHex" />
                                </Grid>
                                <Grid ColumnDefinitions="140,80,*,Auto" Classes="setrow">
                                    <TextBlock Text="音高曲线颜色:" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Width="80" Height="24" CornerRadius="4"
                                            Background="{Binding PitchCurveColorHex, Converter={StaticResource BrushConverter}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding PitchCurveColorHex}" VerticalAlignment="Center" Margin="10,0" />
                                    <Button Grid.Column="3" Content="选择" Padding="12,4"
                                            Command="{Binding ChooseColorCommand}" CommandParameter="PitchCurveColorHex" />
                                </Grid>
                            </StackPanel>
                        </fa:FASettingsExpander>
                    </ScrollViewer>

                    <!-- 设置页 -->
                    <ScrollViewer Grid.Row="1" x:Name="PageSettings" IsVisible="False" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="720" Spacing="12" Margin="0,0,12,0">
                            <fa:FASettingsExpander Header="外观" Description="切换深色 / 浅色主题">
                                <fa:FASettingsExpander.IconSource>
                                    <fa:FASymbolIconSource Symbol="{x:Static fa:FASymbol.Setting}" FontSize="20" />
                                </fa:FASettingsExpander.IconSource>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                    <StackPanel>
                                        <TextBlock Text="当前主题" />
                                        <TextBlock Text="{Binding ThemeText}" Classes="hint" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="切换主题" Classes="accent" Padding="16,6"
                                            Command="{Binding ToggleThemeCommand}" />
                                </Grid>
                            </fa:FASettingsExpander>
                            <fa:FASettingsExpander Header="关于" Description="UST Visualizer · C# + Avalonia">
                                <fa:FASettingsExpander.IconSource>
                                    <fa:FASymbolIconSource Symbol="{x:Static fa:FASymbol.Audio}" FontSize="20" />
                                </fa:FASettingsExpander.IconSource>
                                <StackPanel Spacing="4" Margin="0,6,0,0">
                                    <TextBlock Text="UTAU 工程可视化 · 生成滚动音符视频" />
                                    <TextBlock Classes="hint" Text="许可证：GNU GPL v3" />
                                </StackPanel>
                            </fa:FASettingsExpander>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </fa:FANavigationView.Content>
        </fa:FANavigationView>
    </DockPanel>
</Window>






